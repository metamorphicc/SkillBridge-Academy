{
  "name": "SkillBridge Lead Events Pipeline",
  "nodes": [
    {
      "name": "Lead Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [120, 260],
      "parameters": {
        "path": "skillbridge/lead-events",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "name": "Validate Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, 260],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$headers['x-skillbridge-secret']}}",
              "operation": "equals",
              "value2": "skillbridge-local-secret"
            }
          ]
        }
      }
    },
    {
      "name": "Append Google Sheets Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [660, 180],
      "parameters": {
        "operation": "append",
        "sheetName": "Leads",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "event": "={{$json.body.event}}",
            "eventId": "={{$json.body.eventId}}",
            "emittedAt": "={{$json.body.emittedAt}}",
            "createdAt": "={{$json.body.lead.createdAt}}",
            "qualifiedAt": "={{$json.body.lifecycle.qualifiedAt || ''}}",
            "name": "={{$json.body.lead.name}}",
            "school": "={{$json.body.lead.school}}",
            "contact": "={{$json.body.lead.contact}}",
            "need": "={{$json.body.lead.need}}",
            "goal": "={{$json.body.lead.answers.goal}}",
            "level": "={{$json.body.lead.answers.level}}",
            "start": "={{$json.body.lead.answers.start}}",
            "format": "={{$json.body.lead.answers.format}}",
            "budget": "={{$json.body.lead.answers.budget}}",
            "contactTime": "={{$json.body.lead.answers.contactTime}}",
            "score": "={{$json.body.scoring.score}}",
            "points": "={{$json.body.scoring.points}}",
            "status": "={{$json.body.scoring.status}}",
            "nextAction": "={{$json.body.scoring.nextAction}}",
            "source": "={{$json.body.lead.source}}",
            "managerAlert": "={{$json.body.routing.managerAlert}}",
            "followUp": "={{$json.body.routing.followUp}}",
            "ragSources": "={{$json.body.rag.sources.join('|')}}"
          }
        }
      }
    },
    {
      "name": "Is Intake",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 180],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.event}}",
              "operation": "equals",
              "value2": "lead.created"
            }
          ]
        }
      }
    },
    {
      "name": "Notify Intake",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1220, 40],
      "parameters": {
        "operation": "sendMessage",
        "text": "={{'New intake lead\\nName: ' + $json.name + '\\nSchool: ' + $json.school + '\\nContact: ' + $json.contact + '\\nNeed: ' + $json.need + '\\nNext: continue qualification in Telegram.'}}"
      }
    },
    {
      "name": "Wait For Qualification",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1500, 40],
      "parameters": {}
    },
    {
      "name": "Is Hot",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1220, 280],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.score}}",
              "operation": "equals",
              "value2": "hot"
            }
          ]
        }
      }
    },
    {
      "name": "Notify Hot Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1500, 180],
      "parameters": {
        "operation": "sendMessage",
        "text": "={{'HOT lead - call first\\nName: ' + $json.name + '\\nContact: ' + $json.contact + '\\nGoal: ' + $json.goal + '\\nStart: ' + $json.start + '\\nBudget: ' + $json.budget + '\\nNext: ' + $json.nextAction}}"
      }
    },
    {
      "name": "Create Call Window Follow-up",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1780, 180],
      "parameters": {}
    },
    {
      "name": "Is Warm",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1500, 420],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.score}}",
              "operation": "equals",
              "value2": "warm"
            }
          ]
        }
      }
    },
    {
      "name": "Notify Warm Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1780, 340],
      "parameters": {
        "operation": "sendMessage",
        "text": "={{'WARM lead - write today\\nName: ' + $json.name + '\\nContact: ' + $json.contact + '\\nGoal: ' + $json.goal + '\\nStart: ' + $json.start + '\\nNext: ' + $json.nextAction}}"
      }
    },
    {
      "name": "Create Fit Questions Follow-up",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2060, 340],
      "parameters": {}
    },
    {
      "name": "Notify Cold Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1780, 540],
      "parameters": {
        "operation": "sendMessage",
        "text": "={{'COLD lead - add to nurture\\nName: ' + $json.name + '\\nContact: ' + $json.contact + '\\nGoal: ' + $json.goal + '\\nStart: ' + $json.start + '\\nNext: ' + $json.nextAction}}"
      }
    },
    {
      "name": "Create Nurture Follow-up",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2060, 540],
      "parameters": {}
    }
  ],
  "connections": {
    "Lead Event Webhook": {
      "main": [[{ "node": "Validate Secret", "type": "main", "index": 0 }]]
    },
    "Validate Secret": {
      "main": [
        [{ "node": "Append Google Sheets Row", "type": "main", "index": 0 }],
        []
      ]
    },
    "Append Google Sheets Row": {
      "main": [[{ "node": "Is Intake", "type": "main", "index": 0 }]]
    },
    "Is Intake": {
      "main": [
        [{ "node": "Notify Intake", "type": "main", "index": 0 }],
        [{ "node": "Is Hot", "type": "main", "index": 0 }]
      ]
    },
    "Notify Intake": {
      "main": [[{ "node": "Wait For Qualification", "type": "main", "index": 0 }]]
    },
    "Is Hot": {
      "main": [
        [{ "node": "Notify Hot Manager", "type": "main", "index": 0 }],
        [{ "node": "Is Warm", "type": "main", "index": 0 }]
      ]
    },
    "Notify Hot Manager": {
      "main": [[{ "node": "Create Call Window Follow-up", "type": "main", "index": 0 }]]
    },
    "Is Warm": {
      "main": [
        [{ "node": "Notify Warm Manager", "type": "main", "index": 0 }],
        [{ "node": "Notify Cold Manager", "type": "main", "index": 0 }]
      ]
    },
    "Notify Warm Manager": {
      "main": [[{ "node": "Create Fit Questions Follow-up", "type": "main", "index": 0 }]]
    },
    "Notify Cold Manager": {
      "main": [[{ "node": "Create Nurture Follow-up", "type": "main", "index": 0 }]]
    }
  }
}
